{
  "name": "source-code-editor-web-extension",
  "version": "0.1.0",
  "description": "A multi-browser VS Code-inspired IDE and source code editor web extension with local file system, OPFS, Git, and OpenVSX support.",
  "author": "Nicolas Dos Santos",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "postinstall": "wxt prepare",
    "prepare": "husky",
    "clean": "wxt clean && git clean -fXd -e '!.idea' -e '!.idea/**' -e '!.vscode' -e '!.vscode/**' -e '!.claude' -e '!.claude/**' -e '!.agents' -e '!.agents/**' -e '!.env' -e '!.env.*'",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:edge": "wxt -b edge",
    "build": "wxt build && wxt build -b firefox && wxt build -b edge",
    "zip": "wxt zip && wxt zip -b firefox && wxt zip -b edge",
    "compile": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "wxt build && playwright test",
    "test:e2e:ui": "wxt build && playwright test --ui",
    "test:e2e:headed": "wxt build && HEADLESS=false playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.{css,vue}\"",
    "lint:css:fix": "stylelint \"src/**/*.{css,vue}\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "screenshots": "wxt build && tsx scripts/generate-screenshots.ts",
    "screenshots:all": "wxt build && tsx scripts/generate-screenshots.ts --all",
    "metadata:check": "tsx scripts/check-store-metadata.ts",
    "metadata:sync": "tsx scripts/sync-store-descriptions.ts",
    "demo:video": "wxt build && tsx scripts/generate-demo-video.ts"
  },
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "dependencies": {
    "@codingame/monaco-vscode-api": "38.0.4",
    "@codingame/monaco-vscode-configuration-service-override": "38.0.4",
    "@codingame/monaco-vscode-css-default-extension": "38.0.4",
    "@codingame/monaco-vscode-debug-service-override": "38.0.4",
    "@codingame/monaco-vscode-explorer-service-override": "38.0.4",
    "@codingame/monaco-vscode-extensions-service-override": "38.0.4",
    "@codingame/monaco-vscode-files-service-override": "38.0.4",
    "@codingame/monaco-vscode-go-default-extension": "38.0.4",
    "@codingame/monaco-vscode-html-default-extension": "38.0.4",
    "@codingame/monaco-vscode-javascript-default-extension": "38.0.4",
    "@codingame/monaco-vscode-json-default-extension": "38.0.4",
    "@codingame/monaco-vscode-keybindings-service-override": "38.0.4",
    "@codingame/monaco-vscode-language-pack-de": "38.0.4",
    "@codingame/monaco-vscode-language-pack-es": "38.0.4",
    "@codingame/monaco-vscode-language-pack-fr": "38.0.4",
    "@codingame/monaco-vscode-language-pack-it": "38.0.4",
    "@codingame/monaco-vscode-language-pack-ja": "38.0.4",
    "@codingame/monaco-vscode-language-pack-pt-br": "38.0.4",
    "@codingame/monaco-vscode-language-pack-zh-hans": "38.0.4",
    "@codingame/monaco-vscode-languages-service-override": "38.0.4",
    "@codingame/monaco-vscode-localization-service-override": "38.0.4",
    "@codingame/monaco-vscode-markdown-basics-default-extension": "38.0.4",
    "@codingame/monaco-vscode-markdown-language-features-default-extension": "38.0.4",
    "@codingame/monaco-vscode-markers-service-override": "38.0.4",
    "@codingame/monaco-vscode-mermaid-markdown-features-default-extension": "38.0.4",
    "@codingame/monaco-vscode-model-service-override": "38.0.4",
    "@codingame/monaco-vscode-outline-service-override": "38.0.4",
    "@codingame/monaco-vscode-preferences-service-override": "38.0.4",
    "@codingame/monaco-vscode-python-default-extension": "38.0.4",
    "@codingame/monaco-vscode-quickaccess-service-override": "38.0.4",
    "@codingame/monaco-vscode-rust-default-extension": "38.0.4",
    "@codingame/monaco-vscode-scm-service-override": "38.0.4",
    "@codingame/monaco-vscode-search-service-override": "38.0.4",
    "@codingame/monaco-vscode-shellscript-default-extension": "38.0.4",
    "@codingame/monaco-vscode-snippets-service-override": "38.0.4",
    "@codingame/monaco-vscode-testing-service-override": "38.0.4",
    "@codingame/monaco-vscode-textmate-service-override": "38.0.4",
    "@codingame/monaco-vscode-theme-defaults-default-extension": "38.0.4",
    "@codingame/monaco-vscode-theme-service-override": "38.0.4",
    "@codingame/monaco-vscode-theme-seti-default-extension": "38.0.4",
    "@codingame/monaco-vscode-timeline-service-override": "38.0.4",
    "@codingame/monaco-vscode-typescript-basics-default-extension": "38.0.4",
    "@codingame/monaco-vscode-view-status-bar-service-override": "38.0.4",
    "@codingame/monaco-vscode-view-title-bar-service-override": "38.0.4",
    "@codingame/monaco-vscode-views-service-override": "38.0.4",
    "@codingame/monaco-vscode-workbench-service-override": "38.0.4",
    "@codingame/monaco-vscode-yaml-default-extension": "38.0.4",
    "@wxt-dev/i18n": "^0.2.8",
    "monaco-editor": "npm:@codingame/monaco-vscode-editor-api@38.0.4",
    "vscode": "npm:@codingame/monaco-vscode-extension-api@38.0.4",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@codingame/monaco-vscode-rollup-vsix-plugin": "38.0.4",
    "@playwright/test": "^1.64.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@wxt-dev/module-vue": "^1.0.3",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "happy-dom": "^21.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.1",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-vue": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.4"
  }
}
